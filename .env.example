# Copy this file to .env and put your real key there.
# .env is listed in .gitignore, so git never commits it.

# Required for live runs (the Anthropic SDK reads this variable).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: the model for the Reasoner and the Arbiter.
# Default in experiment_0.py: claude-haiku-4-5-20251001
NORMA_MODEL=claude-haiku-4-5-20251001
