    {
      "id": "S4-irb-compliance",
      "name": "A funder milestone before the IRB meets",
      "table_row": "P: IRB Compliance",
      "norms": [
        "P-IRB-COMPLIANCE"
      ],
      "description": [
        "Rita must have the coastal survey under way by step three to hit a funder",
        "milestone. The IRB does not meet until step five. She may submit and wait, start",
        "without review, or ask for an expedited waiver. Starting unreviewed is detected two",
        "steps later and suspends the project, so she banks the milestone and loses the work."
      ],
      "focal_agent": "rita",
      "turn_order": [
        "rita",
        "org"
      ],
      "max_steps": 9,
      "sanction_policy": {
        "P-IRB-COMPLIANCE": "project_suspension"
      },
      "detection_delays": {
        "P-IRB-COMPLIANCE": 2
      },
      "world": {
        "resources": [
          "proj-coastal-survey"
        ],
        "agents": [
          {
            "id": "rita",
            "role": "Researcher",
            "display_name": "Rita (project lead)",
            "policy": "irb_waiting_researcher",
            "policy_params": {
