    {
      "id": "S6-authorship-unanimity",
      "name": "Authorship order under a unanimity rule",
      "table_row": "C: Unanimity",
      "norms": [
        "C-UNANIMITY"
      ],
      "description": [
        "Rita, Raj, and Nina share a paper. Raj agrees to whatever order is proposed; Nina",
        "objects to the first proposal and only relents at step five. Rita can wait her out,",
        "submit over her objection, or re-propose an order Nina will accept.",
        "Because the norm binds every author, a submission without agreement violates three",
        "instances at once, and Table 1 has Org:Self sanction all of them, Nina included."
      ],
      "focal_agent": "rita",
      "turn_order": [
        "rita",
        "raj",
        "nina",
        "org"
      ],
      "max_steps": 9,
      "sanction_policy": {
        "C-UNANIMITY": "warning"
      },
      "world": {
        "resources": [
          "paper-consensus"
        ],
        "agents": [
          {
            "id": "rita",
            "role": "Researcher",
            "display_name": "Rita (corresponding author)",
            "policy": "consensus_seeking_author",
            "policy_params": {
              "resource_id": "paper-consensus",
              "order": [
                "rita",
                "raj",
                "nina"
              ],
              "revised_order": [
                "rita",
                "nina",
                "raj"
              ]
            },
            "goal": {
              "description": "Submit the paper before the special issue closes.",
              "submit_resource": "paper-consensus",
              "deadline": 4
            }
          },
          {
            "id": "raj",
            "role": "Researcher",
            "display_name": "Raj (co-author, agreeable)",
            "policy": "agreeing_coauthor",
            "policy_params": {
              "resource_id": "paper-consensus"
            },
            "goal": {
              "description": "See the paper submitted."
            }
          },
          {
            "id": "nina",
            "role": "Researcher",
            "display_name": "Nina (co-author, contests the order)",
            "policy": "objecting_coauthor",
            "policy_params": {
              "resource_id": "paper-consensus",
              "objects_first_n": 1,
              "relents_at": 5,
              "reason": "my contribution warrants second position"
            },
            "goal": {
              "description": "Have the authorship order reflect my contribution."
            }
          },
          {
            "id": "org",
            "role": "Org:Self",
            "display_name": "Org:Self (research office)",
            "policy": "org_monitor",
            "policy_params": {},
            "goal": {
              "description": "Coordinate the collaboration and apply sanctions."
            }
          }
        ],
        "initial_messages": [
          {
            "sender": "org",
            "to": [
              "rita",
              "raj",
              "nina"
            ],
            "broadcast": true,
            "content": "Reminder: a multi-author paper may be submitted only once every author agrees on the authorship order."
          }
        ]
      },
      "variants": [
        {
          "name": "wait-for-all",
          "description": "Rita waits until Nina relents at step five, and misses the deadline.",
          "focal_policy": "consensus_seeking_author"
        },
        {
          "name": "submit-anyway",
          "description": "Rita submits over Nina's objection and makes the deadline.",
          "focal_policy": "impatient_author"
        },
        {
          "name": "renegotiate",
          "description": "Rita re-proposes an order Nina accepts, then submits in time.",
          "focal_policy": "renegotiating_author"
        }
      ],
      "expectations": {
        "wait-for-all": {
          "violations": 0,
          "discharges": 3,
          "sanctions": 0,
          "goal_achieved": true
        },
        "submit-anyway": {
          "violations": 3,
          "discharges": 0,
          "sanctions": 3,
          "goal_achieved": true
        },
        "renegotiate": {
          "violations": 0,
          "discharges": 3,
          "sanctions": 0,
          "goal_achieved": true
        }
      },
      "actions": [
        "propose_authorship",
        "respond_authorship",
        "submit_deliverable",
        "send_message",
        "broadcast",
        "escalate",
        "wait"
      ]
    },
    {
      "id": "S7-authorship-majority",
      "extends": "S6-authorship-unanimity",
      "name": "Authorship order under a majority rule",
      "table_row": "C: Majority",
      "norms": [
        "C-MAJORITY"
      ],
      "description": [
        "The same world and the same three behaviours under the majority rule instead.",
        "Submitting over Nina's objection now discharges the norm rather than violating it,",
        "because Rita and Raj are two of three. This pair of scenarios isolates the cost of",
        "the governance rule itself, holding the agents' behaviour fixed."
      ],
      "sanction_policy": {
        "C-MAJORITY": "warning"
      },
      "expectations": {
        "wait-for-all": {
          "violations": 0,
          "discharges": 3,
          "sanctions": 0,
          "goal_achieved": true
