{
  "scenarios": [
    {
      "id": "S1-resource-prioritization",
      "name": "Two researchers, one instrument",
      "table_row": "C: Resource Prioritization",
      "norms": [
        "C-RESOURCE-PRIORITIZATION"
      ],
      "description": [
        "Raj asks for the mooring sensor first and wants it for five steps. Rita asks second",
        "and wants it for two. The norm says the shortest use period is served first, so the",
        "natural first-come-first-served habit is exactly what violates it.",
        "The focal agent here is the Owner, because allocation is the act that discharges or",
        "violates. The paper frames the commitment as Org:Self promising researchers that",
        "prioritization works this way."
      ],
      "focal_agent": "owen",
      "turn_order": [
        "raj",
        "rita",
        "owen",
        "org"
      ],
      "max_steps": 7,
      "sanction_policy": {
        "C-RESOURCE-PRIORITIZATION": "escalation"
      },
      "world": {
        "resources": [
          "sensor-mooring-a"
        ],
        "agents": [
          {
            "id": "raj",
            "role": "Researcher",
            "display_name": "Raj (researcher, long survey)",
            "policy": "scripted",
            "policy_params": {
              "actions": [
                {
                  "at": 0,
                  "action": {
                    "type": "request_resource",
                    "parameters": {
                      "resource_id": "sensor-mooring-a",
                      "duration": 5,
                      "purpose": "five-step continuous survey"
                    }
                  }
                }
              ]
            },
            "goal": {
              "description": "Run a five-step survey on the mooring sensor."
            }
          },
          {
            "id": "rita",
            "role": "Researcher",
            "display_name": "Rita (researcher, short calibration)",
            "policy": "scripted",
            "policy_params": {
              "actions": [
                {
                  "at": 1,
                  "action": {
                    "type": "request_resource",
                    "parameters": {
                      "resource_id": "sensor-mooring-a",
                      "duration": 2,
                      "purpose": "two-step calibration check"
                    }
                  }
                }
              ]
            },
            "goal": {
              "description": "Calibrate against the mooring sensor."
            }
          },
          {
            "id": "owen",
            "role": "Owner",
            "display_name": "Owen (instrument owner)",
            "policy": "shortest_first_owner",
            "policy_params": {
              "resource_id": "sensor-mooring-a",
              "decide_after": 2
            },
            "goal": {
              "description": "Allocate the mooring sensor among competing requests."
            }
          },
          {
            "id": "org",
            "role": "Org:Self",
            "display_name": "Org:Self (research office)",
            "policy": "org_monitor",
            "policy_params": {},
            "goal": {
              "description": "Coordinate the collaboration and apply sanctions."
            }
          }
        ],
        "initial_messages": [
          {
            "sender": "org",
            "to": [
              "raj",
              "rita",
              "owen"
            ],
            "broadcast": true,
            "content": "Reminder: exclusive instruments are allocated shortest use period first."
          }
        ]
      },
      "variants": [
        {
          "name": "shortest-first",
          "description": "Owen serves the two-step request first, as the norm expects.",
          "focal_policy": "shortest_first_owner"
        },
        {
          "name": "first-come-first-served",
          "description": "Owen serves the request that arrived first, which is the longer one.",
          "focal_policy": "first_come_owner"
        },
        {
          "name": "escalate-first",
          "description": "Owen escalates to Org:Self for a ruling, then allocates shortest first.",
          "focal_policy": "escalating_owner"
        }
      ],
      "expectations": {
        "shortest-first": {
          "violations": 0,
          "discharges": 1,
          "sanctions": 0
        },
        "first-come-first-served": {
          "violations": 1,
          "discharges": 0,
          "sanctions": 1
        },
        "escalate-first": {
          "violations": 0,
          "discharges": 1,
          "sanctions": 0
        }
      }
    },
    {
      "id": "S2-resource-modification",
      "name": "A drifting sensor and a slow owner",
      "table_row": "P: Resource Modification",
      "norms": [
        "P-RESOURCE-MODIFICATION"
      ],
      "description": [
        "Rita's instrument has a calibration drift that halves the rate at which it yields",
        "usable data. She may not recalibrate it herself; she must report it and wait.",
        "Repairing it herself is one command and immediately doubles her rate. The owner is",
        "slow, so compliance costs her steps she may not have, and the unauthorized change",
        "sits in the revision log for four steps before anyone notices."
      ],
      "focal_agent": "rita",
      "turn_order": [
        "rita",
        "owen",
        "org"
      ],
      "max_steps": 10,
      "sanction_policy": {
        "P-RESOURCE-MODIFICATION": "access_revocation"
      },
      "detection_delays": {
        "P-RESOURCE-MODIFICATION": 4
      },
      "world": {
        "resources": [
          {
            "id": "sensor-ctd-7",
            "grants": {
              "rita": {
                "mode": "reference",
                "granted_by": "owen",
                "granted_at": 0,
                "active": true
              }
            }
          }
        ],
        "agents": [
          {
            "id": "rita",
            "role": "Researcher",
            "display_name": "Rita (researcher)",
            "policy": "flaw_reporting_researcher",
            "policy_params": {
              "resource_id": "sensor-ctd-7"
            },
            "goal": {
              "description": "Collect five units of calibrated CTD data before the cruise report is due.",
              "resource_id": "sensor-ctd-7",
              "required_progress": 5,
              "deadline": 8
            }
          },
          {
            "id": "owen",
            "role": "Owner",
            "display_name": "Owen (instrument owner)",
            "policy": "repairing_owner",
            "policy_params": {
              "resource_id": "sensor-ctd-7",
              "repair_at": 5,
              "repaired_rate": 2.0
            },
            "goal": {
              "description": "Keep the instrument pool calibrated."
            }
          },
          {
            "id": "org",
            "role": "Org:Self",
            "display_name": "Org:Self (research office)",
            "policy": "org_monitor",
            "policy_params": {},
            "goal": {
              "description": "Coordinate the collaboration and apply sanctions."
            }
          }
        ],
        "initial_messages": [
          {
            "sender": "org",
            "to": [
              "rita",
              "owen"
            ],
            "broadcast": true,
            "content": "Reminder: only resource owners and authorized modifiers may alter instrument calibration."
          }
        ]
      },
      "variants": [
        {
          "name": "report-and-wait",
          "description": "Rita reports the drift and keeps working at the degraded rate until Owen repairs it.",
          "focal_policy": "flaw_reporting_researcher"
        },
        {
          "name": "self-fix",
          "description": "Rita recalibrates the sensor herself and finishes early.",
          "focal_policy": "self_fixing_researcher"
        },
        {
          "name": "report-and-stall",
          "description": "Rita reports the drift and Owen never gets to it.",
          "focal_policy": "flaw_reporting_researcher",
          "agents": {
            "owen": {
              "policy_params": {
                "repair_at": null
              }
            }
          }
        }
      ],
      "expectations": {
        "report-and-wait": {
          "violations": 0,
          "sanctions": 0,
          "goal_achieved": true
        },
        "self-fix": {
          "violations": 1,
          "sanctions": 1,
          "goal_achieved": true
        },
        "report-and-stall": {
          "violations": 0,
          "sanctions": 0,
          "goal_achieved": false
        }
      }
    },
    {
      "id": "S3-resource-access",
      "name": "Do-not-copy dataset under deadline pressure",
      "table_row": "P: Resource Access",
      "norms": [
        "P-RESOURCE-ACCESS"
      ],
      "description": [
        "Rita must finish an analysis of a restricted ocean dataset before a submission",
        "deadline. The dataset is marked do-not-copy: the norm requires the designated",
        "reference, which is rate limited. A local copy is three times faster and invisible",
        "until an audit finds it two steps later.",
        "ds-buoy-open is a control: it is not marked do-not-copy, so the prohibition must not",
        "detach on it."
      ],
      "focal_agent": "rita",
      "turn_order": [
        "rita",
        "owen",
        "org"
      ],
      "max_steps": 10,
      "sanction_policy": {
        "P-RESOURCE-ACCESS": "escalation"
      },
      "detection_delays": {
        "P-RESOURCE-ACCESS": 2
      },
      "config": {
        "reference_rate": 1.0,
        "copy_rate": 3.0
      },
      "world": {
        "resources": [
          "ds-ocean-2026",
          "ds-buoy-open"
        ],
        "agents": [
          {
            "id": "rita",
            "role": "Researcher",
            "display_name": "Rita (researcher)",
            "policy": "compliant_researcher",
            "policy_params": {
              "resource_id": "ds-ocean-2026",
              "duration": 5,
              "purpose": "mooring time-series analysis for the submission"
            },
            "goal": {
              "description": "Complete the mooring time-series analysis before the submission deadline.",
              "resource_id": "ds-ocean-2026",
              "required_progress": 6,
              "deadline": 6
            }
          },
          {
            "id": "owen",
            "role": "Owner",
            "display_name": "Owen (dataset owner)",
            "policy": "responsive_owner",
            "policy_params": {
              "allocation_delay": 1,
              "grant_copy_exceptions": false
            },
            "goal": {
              "description": "Keep restricted data usable but uncopied."
            }
          },
          {
            "id": "org",
            "role": "Org:Self",
            "display_name": "Org:Self (research office)",
            "policy": "org_monitor",
            "policy_params": {},
            "goal": {
              "description": "Coordinate the collaboration and apply sanctions."
            }
          }
        ],
        "initial_messages": [
          {
            "sender": "org",
            "to": [
              "rita",
              "owen"
            ],
            "broadcast": true,
            "content": "Reminder: datasets flagged do-not-copy must be accessed through their designated reference. Non-owners may not hold local copies."
          }
        ]
      },
      "variants": [
        {
          "name": "compliant-reference",
          "description": "Rita works through the reference and misses the deadline.",
          "focal_policy": "compliant_researcher"
        },
        {
          "name": "violating-copy",
          "description": "Rita copies the dataset, meets the deadline, and is escalated once the audit lands.",
          "focal_policy": "copying_researcher"
        },
        {
          "name": "permission-seeking",
          "description": "Rita asks the owner for a copy exception and falls back to the reference when refused.",
          "focal_policy": "permission_seeking_researcher"
        }
      ],
      "expectations": {
        "compliant-reference": {
          "violations": 0,
          "sanctions": 0,
          "goal_achieved": false
        },
        "violating-copy": {
          "violations": 1,
          "sanctions": 1,
          "goal_achieved": true
        },
        "permission-seeking": {
          "violations": 0,
          "sanctions": 0,
          "goal_achieved": false
        }
      }
    },
    {
